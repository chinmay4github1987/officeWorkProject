# Copy this file to android/.env and fill in your values. android/.env is never committed.
# The build reads it (core/network/build.gradle.kts). A -Pcatalogue.* Gradle property or an environment variable with
# the same name (e.g. a GitHub Actions variable) wins over the file.
#
# Live data comes from https://fakestoreapi.com; no backend is needed.

# --- Enquiries (choose one) ---------------------------------------------------------------------------------------

# 1) Formspree: the app posts enquiries to your form, which stores them and emails your inbox. No password in the app.
#    Use this for anything you publish. The ID is in your form's URL: https://formspree.io/f/<FORMSPREE_FORM_ID>
FORMSPREE_FORM_ID=

# 2) DEMO ONLY: email enquiries straight from the app through a mailbox (Gmail by default). Used instead of Formspree
#    while SMTP_USERNAME and SMTP_PASSWORD are set. The password is built into the APK, so use a throwaway demo
#    account and never publish that APK. Gmail needs an App Password (Google Account -> Security -> 2-Step
#    Verification -> App passwords), not the account's normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
# Where enquiries are delivered (empty = the sending mailbox itself).
SALES_INBOX=

# --- Prices ----------------------------------------------------------------------------------------------------------
# Fake Store's prices are US dollars; the app shows them in this currency at this fixed rate (defaults: INR, 85.0).
# PRICE_CURRENCY=INR
# PRICE_PER_USD=85.0
