# Copy this file to android/.env and fill in your values. android/.env is never committed.
# The build reads it (core/network/build.gradle.kts). A -Pcatalogue.smtp.* Gradle property or an environment
# variable with the same name (e.g. a CI secret) wins over the file.
#
# Warning: every value is built into the APK. Anyone who has the APK can read the password out of it,
# so use a mailbox that only sends these enquiries.

# Product enquiries by email straight from the app (JavaMail for Android).
# Leave SMTP_HOST empty to send enquiries through the backend instead.
SMTP_HOST=
# 465 with ssl, or 587 with starttls. none = no encryption (local testing only).
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=
# Sender address. Defaults to SALES_INBOX when empty.
SMTP_FROM=
# Where enquiries are delivered.
SALES_INBOX=sales@example.com
